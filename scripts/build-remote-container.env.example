# Configuration for build-remote-container.sh — plain KEY=VALUE lines,
# no `export` and no commands.
# Place it next to build-remote-container.sh on the build host, named
# `build-remote-container.env`. Comment lines (#) and blank lines are
# ignored, and values are trimmed.
#
# `{PROJECT}` in a value expands to the resolved project name.
# With the assumed layout /<project>/<channel> (for example
# /volume1/builds/flutterbase/internal) the project name comes from the
# parent directory, so PROJECT does not need to be set. Uncomment the line
# below only when the layout differs.
#PROJECT=flutterbase
# Name of the dev container that runs the build (holds git + Flutter + Android SDK)
APP_DEV_CONTAINER=ubuntu-dev
# User to run the build as inside the container
APP_DEV_USER=sshuser
# Repository working dir inside the container (where scripts/build.sh lives)
APP_DEV_WORKDIR=/work/project/{PROJECT}
# Absolute host-visible path of the built dist/ (required)
APP_DIST_DIR=/volume1/homes/user/work/project/{PROJECT}/dist
# Where builds are handed out from.
# Defaults to the directory holding build-remote-container.sh, which is
# usually what you want — set it only when the script lives elsewhere.
#APP_ARTIFACT_DIR=/volume1/builds/{PROJECT}/internal
# Build variant passed to build.sh. Unset means build.sh's default, release.
#BUILD_MODE=release
