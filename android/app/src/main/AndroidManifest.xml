<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Photo/video library access for upload / auto-upload (photo_manager).
         READ_MEDIA_VISUAL_USER_SELECTED supports the Android 14+ partial
         "selected photos" grant, which the app treats as granted access. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission
        android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"/>
    <!-- Android 12 and below (API <= 32) have no READ_MEDIA_* permissions;
         photo library access needs the legacy storage-read permission there.
         Still reachable: minSdk 31 and 32 fall in this range. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <!-- Saving a server original back into the gallery ("save to this
         device") needs no write permission: Android 10+ files new media
         through MediaStore, and minSdk 31 puts every supported device above
         that line. -->
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/NormalTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- ── App Links ────────────────────────────────────────────
                 android:autoVerify="true" makes Android fetch
                 https://<host>/.well-known/assetlinks.json at install time
                 and compare its signing-certificate fingerprints with this
                 APK's. Only if they match does the system open these links
                 here instead of in the browser — that verification is the
                 difference between an App Link and a custom scheme anyone
                 could claim.

                 The host must equal AppConfig.appLinkHost, and the paths
                 must match the routes in
                 presentation/navigation/app_routes.dart. See
                 docs/DEEP_LINKS.md for generating assetlinks.json and for
                 verifying with adb.

                 The host also serves the PhotoNest web SPA, so the paths are
                 listed explicitly instead of claiming the whole domain: an
                 unscoped filter would make this app intercept every web URL
                 (/admin/..., /media, /sessions, ...) and answer it with the
                 not-found screen. Only the paths the app actually routes are
                 claimed. minSdk is 24, so pathAdvancedPattern (API 31+) is
                 claimed. minSdk is 31, which is what makes
                 android:pathAdvancedPattern (API 31+) usable here: it matches
                 the whole path against a real regex, so the filter can claim
                 album detail without also claiming the SPA-only pages under
                 it. Do not lower minSdk without rewriting these paths — an
                 API 30 device ignores the attribute it does not know and the
                 filter silently widens to every URL on the host. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <!-- Album detail: /albums/42, and nothing else under
                     /albums. The SPA-only album list (/albums) and
                     slideshow (/albums/42/slideshow) stay in the browser
                     because the pattern has to match the entire path. -->
                <data
                    android:scheme="https"
                    android:host="photonest.nolumia.com"
                    android:pathAdvancedPattern="/albums/[0-9]+"/>
                <!-- Deep-link diagnostics screen; no SPA route collides.
                     Query strings are not part of path matching, so
                     /link?ref=email matches this too. -->
                <data
                    android:scheme="https"
                    android:host="photonest.nolumia.com"
                    android:path="/link"/>
            </intent-filter>

            <!-- ── Custom scheme fallback ───────────────────────────────
                 Unverified: any app may register the same scheme, so this
                 is for local testing and for entry points you control —
                 never for a link a stranger can send. Links must use the
                 empty-authority form (photonest:///albums/1), because
                 Flutter's Android embedding builds the in-app route from
                 the URI path and drops the authority. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="photonest"/>
            </intent-filter>

            <!-- Hands the launch intent's URI to the Flutter framework as the
                 initial route, and delivers later ones to the Router API
                 while the app is running. Without it, the intent filters
                 above still open the app, but it always lands on "/".

                 Must sit INSIDE <activity>: FlutterActivity.getMetaData()
                 reads ActivityInfo.metaData, so the same element placed
                 under <application> is never seen — and the failure is
                 silent. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="true" />
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher needs to see which apps can handle a web URL before
             canLaunchUrl() will answer truthfully on API 30+. Both schemes
             are declared so external links of either kind stay visible:
             with only https here, an http-only handler stays invisible and
             canLaunchUrl reports a URL as unopenable that the platform
             could in fact open. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <!-- The two-factor setup sheet hands an `otpauth://` URI to whichever
             authenticator app is installed. Without this query, package
             visibility hides those apps on API 30+ and canLaunchUrl() answers
             false before the platform is ever asked — the button would always
             fall through to the copy-the-key path even with an authenticator
             installed. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="otpauth"/>
        </intent>
    </queries>
</manifest>
