key.properties
app/release.keystore
app/*.jks

# Generated by the Flutter tool from gradle-wrapper.properties on first
# build. Flutter's own template ships only the .properties file, so tracking
# these would just make every build dirty the tree — which the
# `git diff --exit-code` step in scripts/ci.sh would then flag.
gradlew
gradlew.bat
gradle/wrapper/gradle-wrapper.jar
