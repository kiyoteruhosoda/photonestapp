# Dart / Flutter build output.
#
# None of this is reproducible-by-hand state: it is regenerated by
# `flutter pub get` and `flutter build`. Tracking it makes every build dirty
# the working tree, which in turn breaks the `git diff --exit-code` step in
# scripts/ci.sh.
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
coverage/
*.dill

# Distribution bundle written by scripts/build.sh — build output, and the
# artifacts in it are large. Its contents are described by the manifest it
# carries, not by this repository.
dist/

# Machine-local SDK paths.
android/local.properties
android/.gradle/
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh

# Editor and OS noise.
.idea/
*.iml
.vscode/
.DS_Store

# Generated sources are committed on purpose — scripts/ci.sh regenerates
# them and fails on a dirty tree, which is what keeps them honest. Do not
# add *.g.dart / *.freezed.dart here.
